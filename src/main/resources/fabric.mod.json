{
  "schemaVersion": 1,
  "id": "ptp",
  "version": "${version}",
  "name": "Projectiles Trajectory Prediction",
  "description": "Client-only trajectory previews for arrows, snowballs, eggs, tridents, ender pearls and other supported projectiles. No server installation required.",
  "authors": [
    "maDU59_"
  ],
  "contact": {
    "homepage": "https://madu59.github.io/",
    "sources": "https://github.com/Namnarak/ProjectilesTrajectoryPreview1.21"
  },
  "license": "MIT",
  "icon": "assets/ptp/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "fr.madu59.ptp.PtpClient"
    ],
    "modmenu": [
      "fr.madu59.ptp.config.configScreen.ModMenuApiImpl"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.9",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
